# Collaboration server configuration. Copy to .env and adjust.

# Address and port the Node process binds to. Keep HOST on loopback when
# running behind a reverse proxy (the proxy is the only thing that should be
# internet-facing). Defaults: HOST=0.0.0.0, PORT=3000.
HOST=127.0.0.1
PORT=3000

# SQLite file holding the live diagrams and their operation log. This is the
# collaboration server's own store — unrelated to any SQL/Postgres schema the
# app exports.
DATABASE_PATH=./data/drawdb.sqlite

# Access tokens -> user identities. Set ONE of the two.
# Inline JSON:
COLLAB_TOKENS={"<token>":{"userId":"alice","displayName":"Alice","color":"#2563eb"}}
# ...or a path to a JSON file with the same shape (preferred in production, so
# the tokens never sit in the environment/process list):
# COLLAB_TOKENS_FILE=/run/secrets/drawdb-tokens

# Refuse to start unless tokens are configured. NODE_ENV=production has the
# same effect. Always set this for anything internet-facing.
COLLAB_REQUIRE_AUTH=1

# Comma-separated Origin allowlist for the WebSocket upgrade. Required once auth
# is enforced — the server refuses to start without it.
ALLOWED_ORIGINS=https://drawdb.example.com
